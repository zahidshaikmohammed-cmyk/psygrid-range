{
  "model_version": "psygrid-range-v1.1",
  "universe_file": "nifty50.json",
  "data_source": {
    "base_url": "http://140.245.226.102:10000",
    "stock_path": "/public/stock/{symbol}.json",
    "connect_timeout_seconds": 5,
    "read_timeout_seconds": 10,
    "retries": 1,
    "backoff_seconds": 1.0,
    "max_retry_after_seconds": 10,
    "max_response_bytes": 20000000,
    "cache_ttl_seconds": 20,
    "save_raw_live": true,
    "user_agent": "psygrid-range/1.1",
    "expected_service": null,
    "required_fields": [
      "status",
      "symbol"
    ],
    "expected_fields": [
      "service",
      "schema_version",
      "status",
      "symbol",
      "security_id",
      "previous_close",
      "today_open",
      "candles_1m"
    ],
    "ok_statuses": [
      "ok",
      "success",
      "live",
      "open",
      "200",
      "true"
    ],
    "closed_statuses": [
      "closed",
      "market_closed",
      "marketclosed",
      "market_close",
      "close",
      "holiday",
      "no_session",
      "off_hours",
      "after_hours",
      "pre_open",
      "preopen",
      "pre_market",
      "premarket"
    ],
    "timestamp_tz_abbreviations": {
      "IST": "Asia/Kolkata"
    }
  },
  "session": {
    "timezone": "Asia/Kolkata",
    "open": "09:15",
    "close": "15:30"
  },
  "validation": {
    "max_staleness_minutes": 3,
    "max_gap_fraction": 0.1,
    "max_bad_record_fraction": 0.02,
    "min_candles_for_forecast": 20,
    "degraded_gap_fraction": 0.02
  },
  "horizon": {
    "minutes": 60,
    "min_effective_minutes": 15,
    "min_window_coverage": 0.9
  },
  "target": {
    "scaling": "volatility"
  },
  "quantiles": [
    0.1,
    0.25,
    0.5,
    0.75,
    0.9
  ],
  "intervals": {
    "probable": 0.8,
    "central": 0.5
  },
  "model": {
    "type": "lightgbm_quantile",
    "train_stride_minutes": 3,
    "use_symbol_feature": false,
    "early_stopping_fraction": 0.15,
    "params": {
      "n_estimators": 600,
      "learning_rate": 0.03,
      "num_leaves": 31,
      "min_data_in_leaf": 300,
      "feature_fraction": 0.8,
      "bagging_fraction": 0.8,
      "bagging_freq": 1,
      "lambda_l2": 1.0,
      "max_bin": 255,
      "early_stopping_rounds": 50
    }
  },
  "walk_forward": {
    "min_train_sessions": 20,
    "calibration_sessions": 5,
    "test_sessions": 5,
    "embargo_sessions": 1,
    "max_folds": 12
  },
  "warmup": {
    "min_symbol_sessions": 10,
    "history_sessions_for_features": 15
  },
  "calibration": {
    "symbol_shrinkage_sessions": 10
  },
  "confidence": {
    "min_cell_sessions": 5,
    "high_min_cell_sessions": 20,
    "medium_coverage_tolerance": 0.1,
    "high_coverage_tolerance": 0.05,
    "min_skill": 0.0,
    "high_min_skill": 0.05,
    "symbol_min_sessions": 5,
    "symbol_high_coverage_tolerance": 0.07,
    "domain_quantile": 0.005,
    "medium_min_skill_tstat": 1.0,
    "high_min_skill_tstat": 2.0,
    "edge_min_skill_tstat": 2.0,
    "edge_min_sessions": 10
  },
  "market_context": {
    "enabled": true,
    "source": "NIFTY50_PROXY",
    "min_constituent_fraction": 0.6,
    "live_fetch_workers": 6,
    "fetch_connect_timeout_seconds": 3,
    "fetch_read_timeout_seconds": 6,
    "fetch_retries": 0,
    "total_deadline_seconds": 25
  },
  "provenance": {
    "allow_synthetic_model": false
  },
  "baselines": [
    "empirical_tod",
    "volatility_only",
    "recent_realized_vol"
  ]
}